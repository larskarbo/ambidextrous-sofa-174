-/* LEAF if the box is a leaf, otherwise the coordinate to bisect; *value gets Gamma of the box */
-static int evaluate(const Box *b, Workspace *ws, double *value) {
+
+/* ---- telescoping bound on the total area of B_W cap X(w) over a box ----
+   A hallway shape with parameters (fa, fb, gc, gd) is the set {g <= gd+1, f <= fb+1, (f >= fa or g >= gc)}.
+   The union over the box is (a, b, c, d); the core (points in X_j(u) for every u in the box) is (b, a, d, c). */
+#define MAXQ 1024
+typedef struct { Poly p[MAXQ]; int n; } PolyList;
+typedef struct { PolyList L[3]; } Work2;
+static Work2 *work2[MAXTHREADS];
+
+static void shape_pieces(const double prm[][4], int skip, PolyList *out, PolyList *tmp) {
+    PolyList *cur = out, *nxt = tmp, *sw;
+    cur->n = 1;
+    cur->p[0] = window.poly;
+    for (int j = 0; j < K && cur->n > 0; j++) {
+        if (j == skip) continue;
+        double fa = prm[j][0], fb = prm[j][1], gc = prm[j][2], gd = prm[j][3];
+        HalfPlane h0 = at_most(G[j], gd + 1), h1 = at_most(F[j], fb + 1), h2 = at_least(F[j], fa),
+                  h3 = at_most(F[j], fa), h4 = at_least(G[j], gc);
+        nxt->n = 0;
+        for (int i = 0; i < cur->n; i++) {
+            Poly t1, t2, p, q;
+            if (!clip(&cur->p[i], &t1, h0) || !clip(&t1, &t2, h1)) continue;
+            if (clip(&t2, &p, h2) && area(&p) > 0) { if (nxt->n >= MAXQ) die("MAXQ"); nxt->p[nxt->n++] = p; }
+            if (clip(&t2, &q, h3) && clip(&q, &p, h4) && area(&p) > 0) { if (nxt->n >= MAXQ) die("MAXQ"); nxt->p[nxt->n++] = p; }
+        }
+        sw = cur; cur = nxt; nxt = sw;
+    }
+    if (cur != out) *out = *cur;
+}
+
+/* area of the pieces cut by up to three half-planes */
+static double area_cut(const PolyList *L, const HalfPlane *h, int nh) {
+    double s = 0;
+    for (int i = 0; i < L->n; i++) {
+        Poly a = L->p[i], b;
+        int ok = 1;
+        for (int t = 0; t < nh && ok; t++) {
+            ok = clip(&a, &b, h[t]) >= 3;
+            a = b;
+        }
+        if (ok) s += area(&a);
+    }
+    return s;
+}
+
+/* the slab lo <= h <= hi of the affine function h, as two half-planes */
+static void slab(const double *h, double lo, double hi, HalfPlane *out) {
+    out[0] = at_least(h, lo);
+    out[1] = at_most(h, hi);
+}
+
+/* out[k] = area of L cap extra cap {P between s0 and s0 + sgn * t_k}, t_k = h k / n, for k = 0..n */
+static void cum_areas(const PolyList *L, const double *P, double s0, int sgn, double h, int n, const HalfPlane *extra,
+                      int nextra, double *out, PolyList *tmp) {
+    HalfPlane hp[2];
+    double lo = sgn > 0 ? s0 : s0 - h, hi = sgn > 0 ? s0 + h : s0;
+    tmp->n = 0;
+    slab(P, lo, hi, hp);
+    for (int i = 0; i < L->n; i++) {
+        Poly a = L->p[i], b;
+        int ok = clip(&a, &b, hp[0]) >= 3;
+        if (ok) { a = b; ok = clip(&a, &b, hp[1]) >= 3; a = b; }
+        for (int t = 0; t < nextra && ok; t++) { ok = clip(&a, &b, extra[t]) >= 3; a = b; }
+        if (ok) tmp->p[tmp->n++] = a;
+    }
+    out[0] = 0;
+    for (int k = 1; k <= n; k++) {
+        double edge = s0 + sgn * h * k / n, s = 0;
+        HalfPlane cut = sgn > 0 ? at_most(P, edge) : at_least(P, edge);
+        if (k == n) {
+            for (int i = 0; i < tmp->n; i++) s += area(&tmp->p[i]);
+        } else {
+            for (int i = 0; i < tmp->n; i++) {
+                Poly b;
+                if (clip(&tmp->p[i], &b, cut) >= 3) s += area(&b);
+            }
+        }
+        out[k] = s;
+    }
+}
+
+static double bound2(const double *lo, const double *hi, Work2 *w2) {
+    double uni[MAXK][4], core[MAXK][4], cen[MAXK][4], total;
+    PolyList *U = &w2->L[0], *C = &w2->L[1], *tmp = &w2->L[2];
+    for (int j = 0; j < K; j++) {
+        double a = lo[2 * j], b = hi[2 * j], c = lo[2 * j + 1], d = hi[2 * j + 1];
