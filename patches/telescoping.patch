+static inline i64 midpoint(i64 a, i64 b);
+/* ---------------------------------------------------------------- the telescoping bound
+
+ A second test for a leaf box E (not in the paper). For w in E let A(w) = area(B_W cap X(w)); then
+ lambda*(B_W cap X(w)) <= A(w). Move from the centre c of E to w one coordinate at a time; every
+ intermediate point lies in E. When coordinate u1 of hallway j moves from its centre value m by t (0 <= t <= h,
+ h the half-width, h <= 1), the area gained lies in U cap S_gain(t) and the area lost contains
+ C_j cap S_loss(t), where
+   U   = B_W cap Xhat(E)                               (contains X(w') for every w' in E)
+   C_j = B_W cap (cores of the hallways i != j)        (core = points in X_i(u) for every u in the box)
+ and, with a, b, c, d the interval ends of hallway j and m, m2 the midpoints,
+   u1 up:    S_gain = {m+1 < f <= m+1+t},                 S_loss = {m <= f < m+t, g <= c}
+   u1 down:  S_gain = {m-t <= f < m} minus {d <= g <= c+1}, S_loss = {m+1-t < f <= m+1, g <= c+1}
+   u2 up:    S_gain = {m2+1 < g <= m2+1+t},               S_loss = {m2 <= g < m2+t, f <= a}
+   u2 down:  S_gain = {m2-t <= g < m2} minus {b <= f <= a+1}, S_loss = {m2+1-t < g <= m2+1, f <= a+1}
+ (the core of X_j over E is {g <= c+1, f <= a+1, (f >= b or g >= d)}). For t in [t_k, t_{k+1}],
+ t_k = k h / n, the change is at most gain(t_{k+1}) - loss(t_k). Summing the largest such value over the
+ coordinates and both directions bounds A(w) - A(c). The leaf passes if A(c) + this sum <= T.
+*/
+
+#define MAXQ 512
+#define LN_UNI 4
+#define LN_CORE (4 + 5 * MAXH)
+#define LN_CEN (4 + 10 * MAXH)
+#define LN_EXTRA (4 + 15 * MAXH)
+#define NLINE2 (LN_EXTRA + 8)
+
+typedef struct {
+    int n;
+    Poly p[MAXQ];
+} PolyList;
+
+typedef struct {
+    Line ln[NLINE2];
+    PolyList U, C, Ctr, S;
+    Poly bufA[MAXH + 1], bufB[MAXH + 1], bufC[MAXH + 1], t1, t2;
+} Work2;
+
+/* line idx: h_j-scaled function (isg ? g_j : f_j) compared with V (scaled by M h_j): le ? <= : >= */
+static void set_fn_line(Work2 *w, int idx, int j, int isg, int le, i64 V) {
+    const i64 *H = isg ? G[j] : F[j];
+    i64 H0 = isg ? MG0[j] : MF0[j];
+    if (le)
+        set_line(&w->ln[idx], H[1], H[2], to64(sub128(i128_from(V), i128_from(H0))), isg ? dir_g[j] : dir_f[j]);
+    else
+        set_line(&w->ln[idx], -H[1], -H[2], to64(sub128(i128_from(H0), i128_from(V))),
+                 isg ? dir_gneg[j] : dir_fneg[j]);
+}
+
+/* lines of the shape {g <= gd+1, f <= fb+1, (f >= fa or (f <= fa and g >= gc))} of hallway j at base */
+static void set_shape_lines(Work2 *w, int base, int j, i64 fa, i64 fb, i64 gc, i64 gd) {
+    int l = base + 5 * j;
+    set_fn_line(w, l + 0, j, 1, 1, gd + Mh[j]);
+    set_fn_line(w, l + 1, j, 0, 1, fb + Mh[j]);
+    set_fn_line(w, l + 2, j, 0, 0, fa);
+    set_fn_line(w, l + 3, j, 0, 1, fa);
+    set_fn_line(w, l + 4, j, 1, 0, gc);
+}
+
+static void shape_rec(Work2 *w, int base, int skip, int j, const Poly *P, PolyList *out) {
+    Poly *A, *B, *Cc;
+    int l = base + 5 * j;
+    if (j == skip) {
+        shape_rec(w, base, skip, j + 1, P, out);
+        return;
+    }
+    if (j == nhall) {
+        if (P->n < 3) return; /* no area */
+        if (out->n >= MAXQ) die("MAXQ");
+        copy_poly(&out->p[out->n++], P);
+        return;
+    }
+    A = &w->bufA[j];
+    B = &w->bufB[j];
+    Cc = &w->bufC[j];
+    clip(P, w->ln, l + 0, A);
+    if (!A->n) return;
+    clip(A, w->ln, l + 1, B);
+    if (!B->n) return;
+    clip(B, w->ln, l + 2, A);
+    if (A->n) shape_rec(w, base, skip, j + 1, A, out);
+    clip(B, w->ln, l + 3, Cc);
+    if (Cc->n) {
+        clip(Cc, w->ln, l + 4, A);
+        if (A->n) shape_rec(w, base, skip, j + 1, A, out);
+    }
+}
+
+static void build_shape(Work2 *w, int base, int skip, PolyList *out) {
+    out->n = 0;
+    shape_rec(w, base, skip, 0, &rect, out);
+}
+
+static i256 list_area(const PolyList *L) {
+    i256 s = zero256();
+    for (int i = 0; i < L->n; i++) s = add256(s, twice_area(&L->p[i]));
+    return s;
+}
+
+/* out[k] = area of L cap (extra lines) cap slab, for k = 0..nsub; the slab is between the value s0 and
+   s0 + sgn t_k of the function (isg ? g_j : f_j), with t_k = k hw / nsub (hw = the half-width, scaled) */
+static void cum_areas(Work2 *w, const PolyList *L, int j, int isg, i64 s0, int sgn, i64 hw, const int *extra,
+                      int nextra, i256 *out) {
+    int lo_idx = LN_EXTRA + 4, hi_idx = LN_EXTRA + 5, cut_idx = LN_EXTRA + 6;
+    i64 step = hw / nsub, far = sgn > 0 ? s0 + hw : s0 - hw;
+    PolyList *S = &w->S;
+    if (step * nsub != hw) die("sub-slab not exact at chosen scale");
+    set_fn_line(w, lo_idx, j, isg, 0, sgn > 0 ? s0 : far); /* >= lower end */
+    set_fn_line(w, hi_idx, j, isg, 1, sgn > 0 ? far : s0); /* <= upper end */
+    S->n = 0;
+    for (int i = 0; i < L->n; i++) {
+        Poly *a = &w->t1, *b = &w->t2, *t;
+        clip(&L->p[i], w->ln, lo_idx, a);
+        if (a->n < 3) continue;
+        clip(a, w->ln, hi_idx, b);
+        if (b->n < 3) continue;
+        t = a; a = b; b = t;
+        for (int e = 0; e < nextra && a->n >= 3; e++) {
+            clip(a, w->ln, extra[e], b);
+            t = a; a = b; b = t;
+        }
+        if (a->n < 3) continue;
+        copy_poly(&S->p[S->n++], a);
+    }
+    out[0] = zero256();
+    for (int k = 1; k <= nsub; k++) {
+        i256 s = zero256();
+        if (k == nsub) {
+            s = list_area(S);
+        } else {
+            i64 edge = s0 + sgn * step * k;
+            set_fn_line(w, cut_idx, j, isg, sgn > 0, edge); /* sgn > 0: <= edge; else >= edge */
+            for (int i = 0; i < S->n; i++) {
+                clip(&S->p[i], w->ln, cut_idx, &w->t1);
+                if (w->t1.n >= 3) s = add256(s, twice_area(&w->t1));
+            }
+        }
+        out[k] = s;
+    }
+}
+
+#define work2_of(work) ((Work2 *)(work)->w2)
+static int check_leaf_b2(Work2 *w, const i64 *lo, const i64 *hi, i256 *value) {
+    i256 total;
+    memcpy(w->ln, rect_line, sizeof(rect_line));
+    for (int j = 0; j < nhall; j++) {
+        i64 a = lo[2 * j], b = hi[2 * j], c = lo[2 * j + 1], d = hi[2 * j + 1];
+        i64 m1 = midpoint(a, b), m2 = midpoint(c, d);
+        if (b - a > 2 * Mh[j] || d - c > 2 * Mh[j]) return 0; /* the argument needs h <= 1 */
+        set_shape_lines(w, LN_UNI, j, a, b, c, d);
+        set_shape_lines(w, LN_CORE, j, b, a, d, c);
+        set_shape_lines(w, LN_CEN, j, m1, m1, m2, m2);
+    }
+    build_shape(w, LN_CEN, -1, &w->Ctr);
+    total = list_area(&w->Ctr);
+    build_shape(w, LN_UNI, -1, &w->U);
+    for (int j = 0; j < nhall; j++) {
+        i64 a = lo[2 * j], b = hi[2 * j], c = lo[2 * j + 1], d = hi[2 * j + 1];
+        build_shape(w, LN_CORE, j, &w->C);
+        for (int coord = 0; coord < 2; coord++) {
+            int isg = coord, other = !coord;
+            i64 m = coord == 0 ? midpoint(a, b) : midpoint(c, d);
+            i64 hw = coord == 0 ? (b - a) / 2 : (d - c) / 2;
+            i256 best = zero256(), gain[65], loss[65], part[65];
+            int ex[1];
+            if (hw <= 0) continue;
+            for (int dir = 0; dir < 2; dir++) {
+                if (dir == 0) {
+                    cum_areas(w, &w->U, j, isg, m + Mh[j], 1, hw, ex, 0, gain);
+                    set_fn_line(w, LN_EXTRA + 0, j, other, 1, coord == 0 ? c : a);
+                    ex[0] = LN_EXTRA + 0;
+                    cum_areas(w, &w->C, j, isg, m, 1, hw, ex, 1, loss);
+                } else {
+                    i64 lo_cut = coord == 0 ? d : b, hi_cut = (coord == 0 ? c : a) + Mh[j];
+                    if (lo_cut < hi_cut) {
+                        set_fn_line(w, LN_EXTRA + 0, j, other, 1, lo_cut);
+                        ex[0] = LN_EXTRA + 0;
+                        cum_areas(w, &w->U, j, isg, m, -1, hw, ex, 1, gain);
+                        set_fn_line(w, LN_EXTRA + 0, j, other, 0, hi_cut);
+                        cum_areas(w, &w->U, j, isg, m, -1, hw, ex, 1, part);
+                        for (int k = 0; k <= nsub; k++) gain[k] = add256(gain[k], part[k]);
+                    } else {
+                        cum_areas(w, &w->U, j, isg, m, -1, hw, ex, 0, gain);
+                    }
+                    set_fn_line(w, LN_EXTRA + 0, j, other, 1, (coord == 0 ? c : a) + Mh[j]);
+                    ex[0] = LN_EXTRA + 0;
+                    cum_areas(w, &w->C, j, isg, m + Mh[j], -1, hw, ex, 1, loss);
+                }
+                for (int k = 0; k < nsub; k++) {
+                    i256 dlt = sub256(gain[k + 1], loss[k]);
+                    if (cmp256(dlt, best) > 0) best = dlt;
+                }
+            }
+            total = add256(total, best);
+        }
+    }
+    *value = total;
+    return at_most_T(total);
+}
